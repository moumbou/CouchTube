{
  "name": "couchtube",
  "version": "1.0.0",
  "private": true,
  "description": "Your phone is the remote for YouTube on your computer. Chrome extension + relay + phone remote + website.",
  "license": "MIT",
  "author": {
    "name": "Abderrahim Bouzidi",
    "email": "mbouzidi63@gmail.com",
    "url": "https://bouzidi-abderrahim.dev"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @couchtube/relay dev",
    "start": "pnpm --filter @couchtube/relay start",
    "test": "pnpm --filter @couchtube/relay test",
    "e2e": "pnpm --filter @couchtube/e2e test",
    "check": "pnpm -r --if-present check",
    "build:extension": "pnpm --filter @couchtube/extension build",
    "brand:render": "pnpm --filter @couchtube/brand render"
  }
}
