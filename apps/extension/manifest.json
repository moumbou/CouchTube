{
  "manifest_version": 3,
  "name": "CouchTube – phone remote for YouTube",
  "short_name": "CouchTube",
  "version": "0.1.0",
  "description": "Scan a QR code with your phone and control YouTube on this computer: play, seek, volume, speed, search and pick videos from bed.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CouchTube – show pairing QR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
